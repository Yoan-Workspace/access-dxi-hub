# Copier ce fichier vers .env ou .env.local (les deux sont lus par server.js).
# Webhook du canal Teams (Workflows : Send webhook alerts to a channel).
# Sans cette variable, la création de ticket fonctionne normalement, sans notification.
TEAMS_WEBHOOK_URL=

# Lien affiché dans le message (optionnel).
APP_PUBLIC_URL=http://localhost:3000
