# Copier ce fichier vers .env ou .env.local, DANS LE MÊME DOSSIER QUE server.js
# (pas dans dist/). npm run build ne copie pas ce fichier.
#
# TEAMS_WEBHOOK_URL est lu au lancement de `node server.js`, pas à la compilation.
TEAMS_WEBHOOK_URL=

# Lien optionnel (affiché dans certains messages).
APP_PUBLIC_URL=http://IP-DE-LA-BOX:3000

# VITE_API_URL sert uniquement à `npm run dev`.
# Ne pas s'en servir pour la prod : le site et l'API sont déjà sur le même serveur.
